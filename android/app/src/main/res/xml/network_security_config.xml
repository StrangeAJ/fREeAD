<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext allowed app-wide: many RSS feeds are HTTP-only, and the
         Ollama provider connects to a local server over plain HTTP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
